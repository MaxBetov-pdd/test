#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${ICH_ROOT:-$(cd -- "$SCRIPT_DIR/.." && pwd)}"

if [[ -r /etc/default/ich-live ]]; then
    # shellcheck disable=SC1091
    source /etc/default/ich-live
fi

PYTHON="${ICH_PYTHON:-$ROOT/.venv-linux/bin/python}"

usage() {
    cat <<'EOF'
ICH A12/A13 Linux host

Usage:
  ich doctor
  ich status
  ich boot [--bootchain PATH] [--with-fw]
  ich build [arguments]
  ich iproxy [LOCAL_PORT] [DEVICE_PORT]
  ich setup

The Live ISO is pinned by default to iPhone12,8/d79ap and its configured ECID.
All boot operations are temporary and use Apple DFU/Recovery USB interfaces.
EOF
}

require_python() {
    if [[ ! -x "$PYTHON" ]]; then
        echo "ICH Python environment is missing: $PYTHON" >&2
        echo "Run: bash $ROOT/linux/setup.sh" >&2
        exit 1
    fi
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command_name" in
    help|-h|--help)
        usage
        ;;
    setup)
        exec bash "$ROOT/linux/setup.sh" "$@"
        ;;
    doctor)
        echo "ICH root: $ROOT"
        echo "Kernel: $(uname -srmo)"
        echo "Expected board: ${ICH_EXPECTED_BOARD:-not pinned}"
        echo "Expected ECID: ${ICH_EXPECTED_ECID:-not pinned}"
        command -v lsusb >/dev/null && lsusb -d 05ac: || true
        require_python
        "$PYTHON" -c 'import usb.core, pyimg4; print("Python/libusb: OK")'
        "$PYTHON" "$ROOT/windows/status.py" || true
        ;;
    status)
        require_python
        exec "$PYTHON" "$ROOT/windows/status.py" "$@"
        ;;
    boot)
        require_python
        export ICH_EXPECTED_BOARD="${ICH_EXPECTED_BOARD:-d79ap}"
        exec "$PYTHON" "$ROOT/windows/boot.py" "$@"
        ;;
    build)
        require_python
        exec "$PYTHON" "$ROOT/windows/build.py" "$@"
        ;;
    iproxy)
        local_port="${1:-2222}"
        device_port="${2:-22}"
        if ! command -v iproxy >/dev/null; then
            echo "iproxy is missing; install libusbmuxd-tools" >&2
            exit 1
        fi
        exec iproxy "$local_port" "$device_port"
        ;;
    *)
        echo "Unknown command: $command_name" >&2
        usage >&2
        exit 2
        ;;
esac
